<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans (SIL OFL 1.1, android/licenses/), bundled so the app
     and widget look the same on every phone and work offline. textStyle
     bold picks the 700 file. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/jakarta_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/jakarta_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/jakarta_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/jakarta_bold" android:fontStyle="normal" android:fontWeight="700" />
    <font android:font="@font/jakarta_extrabold" android:fontStyle="normal" android:fontWeight="800" />
</font-family>
