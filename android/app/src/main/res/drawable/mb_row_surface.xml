<?xml version="1.0" encoding="utf-8"?>
<!-- A row inside a list card: opaque surface (a swipe slides it over the
     Done / Later colour) with a ripple. The card rounds the corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mb_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mb_surface" />
        </shape>
    </item>
</ripple>
