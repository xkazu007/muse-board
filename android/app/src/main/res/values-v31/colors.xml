<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget tokens on Android 12+, light: Material You system colors,
         derived from the wallpaper. accent1 = primary hue, accent2 = a
         muted version of it. Tone pairs keep text contrast above 4.5:1. -->
    <color name="mb_surface">@android:color/system_accent1_100</color>
    <color name="mb_on_surface">@android:color/system_accent1_900</color>
    <color name="mb_muted">@android:color/system_accent2_700</color>
    <color name="mb_primary">@android:color/system_accent1_600</color>
    <color name="mb_on_primary">@android:color/system_accent1_0</color>
    <color name="mb_inset">@android:color/system_accent2_100</color>
</resources>
