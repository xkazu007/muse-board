<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon background (mipmap-anydpi-v26). -->
    <color name="widget_bg">#0E0E10</color>

    <!-- Design tokens (docs/design-system.md), light variant; values-night
         holds the dark one (the main look). Fixed palette: near-black /
         warm white, one warm yellow accent used sparingly. Same values as
         the web app's CSS variables. Every text pair is >= 4.5:1. -->
    <color name="mb_page">#F7F6F2</color>
    <color name="mb_surface">#FFFFFF</color>
    <color name="mb_inset">#EFEDE6</color>
    <color name="mb_border">#E4E2DA</color>
    <color name="mb_on_surface">#18181B</color>
    <color name="mb_muted">#57534E</color>
    <!-- primary = the yellow as a fill (Done, primary buttons), with
         on_primary on top; accent = the accent as text or a thin line, a
         deep amber here because yellow on white is unreadable. -->
    <color name="mb_primary">#F5C542</color>
    <color name="mb_on_primary">#1F1800</color>
    <color name="mb_accent">#8A6200</color>

    <!-- Chips (docs/design-system.md, "Urgency and size"). Deadline: warmer
         as it nears, never red (overdue is deep orange). Estimate: a cool
         scale, longer = further along it. fg = text, bg = chip fill. -->
    <color name="mb_due_overdue">#B13D08</color>
    <color name="mb_due_overdue_bg">#FDE4D5</color>
    <color name="mb_due_today">#954F00</color>
    <color name="mb_due_today_bg">#FDEBD3</color>
    <color name="mb_due_tomorrow">#765900</color>
    <color name="mb_due_tomorrow_bg">#FBF0C9</color>
    <color name="mb_due_week">#3F3F46</color>
    <color name="mb_due_week_bg">#EFEDE6</color>
    <color name="mb_est_quick">#0F6E47</color>
    <color name="mb_est_quick_bg">#D7F1E4</color>
    <color name="mb_est_short">#0A5899</color>
    <color name="mb_est_short_bg">#DBEAFA</color>
    <color name="mb_est_long">#5638BF</color>
    <color name="mb_est_long_bg">#E7E0FB</color>
    <color name="mb_est_big">#A0215C</color>
    <color name="mb_est_big_bg">#F9DCE9</color>
</resources>
