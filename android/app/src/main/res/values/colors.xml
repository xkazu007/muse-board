<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon background (mipmap-anydpi-v26). -->
    <color name="widget_bg">#0E0E10</color>

    <!-- Design tokens (docs/design-system.md), light variant; values-night
         holds the dark one (the main look). Fixed palette: near-black /
         warm white, one warm yellow accent used sparingly. Same values as
         the web app's CSS variables. Every text pair is >= 4.5:1. -->
    <color name="mb_page">#F7F6F2</color>
    <color name="mb_surface">#FFFFFF</color>
    <color name="mb_inset">#EFEDE6</color>
    <color name="mb_border">#E4E2DA</color>
    <color name="mb_on_surface">#18181B</color>
    <color name="mb_muted">#57534E</color>
    <!-- primary = the yellow as a fill (Done, primary buttons), with
         on_primary on top; accent = the accent as text or a thin line, a
         deep amber here because yellow on white is unreadable. -->
    <color name="mb_primary">#F5C542</color>
    <color name="mb_on_primary">#1F1800</color>
    <color name="mb_accent">#8A6200</color>
</resources>
