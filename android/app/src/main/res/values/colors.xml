<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon background (mipmap-anydpi-v26). -->
    <color name="widget_bg">#121212</color>

    <!-- Widget design tokens (docs/design-system.md). This is the static
         fallback palette for Android 8 to 11, light; values-night holds the
         dark one. On Android 12+ values-v31 / values-night-v31 swap in the
         wallpaper-based system colors (Material You). Same values as the
         web app's CSS variables. -->
    <color name="mb_surface">#dae2ff</color>
    <color name="mb_on_surface">#001a41</color>
    <color name="mb_muted">#3a4a6b</color>
    <color name="mb_primary">#2b5bb5</color>
    <color name="mb_on_primary">#ffffff</color>
    <color name="mb_inset">#c6d3fa</color>
    <!-- App page background (the web app's "page" token). -->
    <color name="mb_page">#f9f9ff</color>
</resources>
