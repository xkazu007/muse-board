<?xml version="1.0" encoding="utf-8"?>
<!-- Focus widget (docs/design-system.md). 4×2: the first step of the
     current task in large text, one big Done, Later. Taller sizes also show
     the "Then" list (WidgetUpdater picks per size on Android 12+).

     Only RemoteViews classes are allowed here (build-manual.sh checks).
     Everything the code toggles starts hidden; the root id is
     @android:id/background so Android 12+ clips it to the launcher's
     widget shape. The picker uses widget_preview.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mb_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mb_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/mb_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/mb_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/mb_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mb_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_loading"
                android:textColor="@color/mb_on_surface"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mb_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mb_then"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mb_btn_done"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/mb_done_bg"
                android:contentDescription="@string/done_label"
                android:scaleType="center"
                android:src="@drawable/mb_ic_check"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mb_btn_later"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/later"
                android:textColor="@color/mb_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Then" list: taller widget sizes only. -->
    <LinearLayout
        android:id="@+id/mb_upnext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/mb_inset_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mb_up_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mb_up_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mb_up_1_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mb_up_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mb_up_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mb_up_2_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mb_up_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mb_up_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mb_up_3_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
