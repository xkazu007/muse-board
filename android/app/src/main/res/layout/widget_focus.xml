<?xml version="1.0" encoding="utf-8"?>
<!-- Focus widget (docs/design-system.md). Android 12+ uses the twin in
     layout-v31/ (Done is a native CheckBox there): keep the two in step.

     4×2: the first step of the
     current task in large text, one big Done, Later. Taller sizes also show
     the "Then" list (WidgetUpdater picks per size on Android 12+).

     Only RemoteViews classes are allowed here (build-manual.sh checks).
     Everything the code toggles starts hidden; the root id is
     @android:id/background so Android 12+ clips it to the launcher's
     widget shape. The picker uses widget_preview.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mb_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Deadline chip: one per colour, the code shows the right one -->
                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_due_overdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mb_chip_due_overdue"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_due_overdue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_due_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mb_chip_due_today"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_due_today"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_due_tomorrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mb_chip_due_tomorrow"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_due_tomorrow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_due_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mb_chip_due_week"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_due_week"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mb_muted"
                    android:textSize="13sp" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/mb_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_loading"
                android:textColor="@color/mb_on_surface"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Task title, then the estimate chip at the end (cool colours by
                 length; one view per colour, the code shows the right one) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_task"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mb_muted"
                    android:textSize="13sp" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_est_quick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/mb_chip_est_quick"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_est_quick"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_est_short"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/mb_chip_est_short"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_est_short"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_est_long"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/mb_chip_est_long"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_est_long"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_est_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/mb_chip_est_big"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/mb_est_big"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Then line; after a Done it becomes "✓ Done. 2 today." with
                 an Undo next to it (32dp tall to stay tappable). -->
            <LinearLayout
                android:id="@+id/mb_then_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:minHeight="24dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_then"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mb_muted"
                    android:textSize="12sp" />

                <!-- Go-to link of the focus task (issue #12) -->
                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_open"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/open_link_short"
                    android:textColor="@color/mb_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="@font/jakarta"
                    android:id="@+id/mb_undo"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/undo"
                    android:textColor="@color/mb_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mb_btn_done"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/mb_done_bg"
                android:contentDescription="@string/done_label"
                android:scaleType="center"
                android:src="@drawable/mb_ic_check"
                android:visibility="gone" />

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_btn_later"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/mb_pill_tonal"
                android:gravity="center"
                android:minWidth="60dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/later"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Later choices, shown in place of Done after tapping Later. Labels
         and actions are set by WidgetUpdater; "Tonight" hides after 19:00. -->
    <LinearLayout
        android:id="@+id/mb_later_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:fontFamily="@font/jakarta"
            android:id="@+id/mb_later_1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/mb_chip_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/mb_on_surface"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:fontFamily="@font/jakarta"
            android:id="@+id/mb_later_2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/mb_chip_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/mb_on_surface"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:fontFamily="@font/jakarta"
            android:id="@+id/mb_later_3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/mb_chip_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/mb_on_surface"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- "Then" list: taller widget sizes only. -->
    <LinearLayout
        android:id="@+id/mb_upnext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/mb_inset_bg"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mb_up_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_up_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp" />

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_up_1_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mb_up_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_up_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp" />

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_up_2_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mb_up_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_up_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mb_on_surface"
                android:textSize="14sp" />

            <TextView
                android:fontFamily="@font/jakarta"
                android:id="@+id/mb_up_3_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/mb_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
