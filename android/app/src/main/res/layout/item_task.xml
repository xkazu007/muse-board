<?xml version="1.0" encoding="utf-8"?>
<!-- One task row: swipe right = Done (or Undo for a done task), swipe
     left = Later, long-press = menu. -->
<tech.mourid.museboard.SwipeRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <include layout="@layout/swipe_background" />

    <LinearLayout
        android:id="@+id/task_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/mb_row_surface"
        android:gravity="center_vertical"
        android:longClickable="true"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/mb_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/task_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/mb_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- "Too big?" (issue #7): after two snoozes -->
            <TextView
                android:id="@+id/task_too_big"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/mb_chip_tonal_inset"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/too_big"
                android:textColor="@color/mb_on_surface"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/task_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/mb_muted"
            android:textSize="13sp" />

        <!-- Go-to link (issue #12) -->
        <ImageView
            android:id="@+id/task_open"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="-12dp"
            android:background="@drawable/mb_ripple_rounded"
            android:contentDescription="@string/open_link"
            android:scaleType="center"
            android:src="@drawable/mb_ic_link24"
            android:visibility="gone" />
    </LinearLayout>
</tech.mourid.museboard.SwipeRow>
