<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add (issue #6): title + first step (both required), optional
     when / where. Rises above the keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mb_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:alpha="0.4"
        android:background="@drawable/mb_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/add_title"
        android:textColor="@color/mb_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/add_task_title"
        style="@style/MuseBoard.Field"
        android:layout_marginTop="14dp"
        android:hint="@string/add_hint_title"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="200" />

    <EditText
        android:id="@+id/add_task_step"
        style="@style/MuseBoard.Field"
        android:layout_marginTop="10dp"
        android:hint="@string/add_hint_step"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="140" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp"
        android:text="@string/step_rule"
        android:textColor="@color/mb_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/add_task_when"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/mb_pill_tonal"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/mb_ic_clock24"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/add_when"
            android:textColor="@color/mb_on_surface"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/add_task_where"
            style="@style/MuseBoard.Field"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:hint="@string/add_hint_where"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="40" />
    </LinearLayout>

    <!-- Optional time estimate: one chip at a time, tap again to clear -->
    <LinearLayout
        android:id="@+id/add_task_estimate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <EditText
        android:id="@+id/add_task_link"
        style="@style/MuseBoard.Field"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:hint="@string/add_hint_link"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1" />

    <TextView
        android:id="@+id/add_task_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="4dp"
        android:textColor="@color/mb_on_surface"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/add_task_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/mb_button_primary"
        android:enabled="false"
        android:stateListAnimator="@animator/mb_press"
        android:text="@string/add_save"
        android:textAllCaps="false"
        android:textColor="@color/mb_on_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
