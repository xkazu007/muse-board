<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add (issue #6): title + first step (both required), optional
     when / where / time / link. Add sits in the title row so the keyboard
     never hides it; the fields scroll above the keyboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/mb_sheet_bg"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:alpha="0.4"
        android:background="@drawable/mb_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_title"
            android:textColor="@color/mb_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/add_task_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/mb_button_primary"
            android:enabled="false"
            android:minWidth="88dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@animator/mb_press"
            android:text="@string/add_save"
            android:textAllCaps="false"
            android:textColor="@color/mb_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/add_task_title"
                style="@style/MuseBoard.Field"
                android:layout_marginTop="14dp"
                android:hint="@string/add_hint_title"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="200" />

            <EditText
                android:id="@+id/add_task_step"
                style="@style/MuseBoard.Field"
                android:layout_marginTop="10dp"
                android:hint="@string/add_hint_step"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="140" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="6dp"
                android:text="@string/step_rule"
                android:textColor="@color/mb_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/add_task_when"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/mb_field_bg"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/mb_ic_clock24"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@animator/mb_press"
                    android:text="@string/add_when"
                    android:textColor="@color/mb_on_surface"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/add_task_where"
                    style="@style/MuseBoard.Field"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:hint="@string/add_hint_where"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="40" />
            </LinearLayout>

            <!-- Optional time estimate: one chip at a time, tap again to
                 clear. Scrolls sideways on narrow phones. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/add_task_estimate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/add_task_link"
                style="@style/MuseBoard.Field"
                android:layout_marginTop="8dp"
                android:hint="@string/add_hint_link"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                android:id="@+id/add_task_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="6dp"
                android:textColor="@color/mb_on_surface"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
