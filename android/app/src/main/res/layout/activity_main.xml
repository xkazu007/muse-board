<?xml version="1.0" encoding="utf-8"?>
<!-- App screen, same design as the widget and web app
     (docs/design-system.md). Focus card and task rows are SwipeRows:
     swipe right = Done, swipe left = Later, long-press = menu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mb_page">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="120dp">

        <!-- Header, like One UI's own apps: a big title with its actions on
             the same row (Calendar, then ⋮ for History, Theme, Refresh…),
             the date under it. No brand line, no small caps labels. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text="@string/heading_today"
                android:textColor="@color/mb_on_surface"
                android:textSize="32sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_calendar"
                style="@style/MuseBoard.TopIcon"
                android:contentDescription="@string/calendar"
                android:src="@drawable/mb_ic_calendar24" />

            <ImageView
                android:id="@+id/btn_more"
                style="@style/MuseBoard.TopIcon"
                android:contentDescription="@string/more_options"
                android:src="@drawable/mb_ic_more24" />
        </LinearLayout>

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingStart="8dp"
            android:textColor="@color/mb_muted"
            android:textSize="15sp" />

        <!-- Offline: the cached board stays, with this quiet line -->
        <TextView
            android:id="@+id/offline_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/offline_note"
            android:textColor="@color/mb_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- First run: paste the board token once -->
        <LinearLayout
            android:id="@+id/token_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/mb_card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/token_title"
                android:textColor="@color/mb_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/token_hint"
                android:textColor="@color/mb_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/token_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:autofillHints=""
                android:background="@drawable/mb_field_bg"
                android:hint="@string/token_hint_input"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mb_on_surface"
                android:textColorHint="@color/mb_muted" />

            <Button
                android:id="@+id/token_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/mb_button_primary"
                android:stateListAnimator="@animator/mb_press"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/mb_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/token_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/token_invalid"
                android:textColor="@color/mb_on_surface"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Signed in -->
        <LinearLayout
            android:id="@+id/board_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <tech.mourid.museboard.SwipeRow
                android:id="@+id/focus_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <include layout="@layout/swipe_background" />

                <LinearLayout
                    android:id="@+id/focus_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mb_card_bg"
                    android:longClickable="true"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:stateListAnimator="@animator/mb_press">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Deadline chip (coloured by how near it is), then the
                                 plan as plain text: "21:00 · desk" -->
                            <LinearLayout
                                android:id="@+id/focus_meta_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/focus_due"
                                    style="@style/MuseBoard.Chip"
                                    android:layout_marginEnd="8dp"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/focus_meta"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/mb_muted"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/focus_step"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="@color/mb_on_surface"
                                android:textSize="27sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/focus_task"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/mb_muted"
                                android:textSize="14sp" />

                            <!-- "Too big?" (issue #7): after two snoozes -->
                            <TextView
                                android:id="@+id/focus_too_big"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/mb_chip_tonal_inset"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/too_big"
                                android:textColor="@color/mb_on_surface"
                                android:textSize="13sp"
                                android:visibility="gone"
                                android:stateListAnimator="@animator/mb_press" />
                            <!-- Go-to link (issue #12) -->
                            <TextView
                                android:id="@+id/focus_open"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/mb_chip_tonal_inset"
                                android:gravity="center"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/open_link"
                                android:textColor="@color/mb_on_surface"
                                android:textSize="13sp"
                                android:visibility="gone"
                                android:stateListAnimator="@animator/mb_press" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/focus_check"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@null"
                                android:button="@drawable/mb_check_button"
                                android:contentDescription="@string/done_label"
                                android:gravity="center"
                                android:paddingStart="2dp"
                                android:paddingTop="2dp" />

                            <TextView
                                android:id="@+id/focus_later"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/mb_pill_tonal_inset"
                                android:gravity="center"
                                android:minWidth="64dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="@string/later"
                                android:textColor="@color/mb_on_surface"
                                android:textSize="14sp"
                                android:stateListAnimator="@animator/mb_press" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Bottom row: checklist progress ("✓ 2/5") on the left,
                         the estimate chip in the corner (cool colours, longer =
                         further along the scale) -->
                    <LinearLayout
                        android:id="@+id/focus_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/focus_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/mb_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/focus_estimate"
                            style="@style/MuseBoard.Chip"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </tech.mourid.museboard.SwipeRow>

            <TextView
                android:id="@+id/gesture_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:text="@string/gesture_hint"
                android:textColor="@color/mb_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Muse's suggestion: one at a time, the owner decides -->
            <LinearLayout
                android:id="@+id/suggestion_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/mb_card_bg"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/mb_ic_spark24" />

                    <TextView
                        android:id="@+id/suggestion_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/mb_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/suggestion_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingStart="30dp"
                    android:textColor="@color/mb_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- What applying does: "First step: …", "New: …" -->
                <TextView
                    android:id="@+id/suggestion_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/mb_snackbar_bg"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/mb_on_surface"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/suggestion_dismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/mb_ripple_rounded"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@animator/mb_press"
                        android:text="@string/suggestion_dismiss"
                        android:textColor="@color/mb_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/suggestion_apply"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/mb_pill_tonal_inset"
                        android:gravity="center"
                        android:minWidth="88dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:stateListAnimator="@animator/mb_press"
                        android:text="@string/suggestion_apply"
                        android:textColor="@color/mb_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Group filter (issue #12): only when there are 2+ groups -->
            <HorizontalScrollView
                android:id="@+id/group_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/group_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/label_then"
                style="@style/MuseBoard.SectionLabel"
                android:text="@string/section_then" />

            <LinearLayout
                android:id="@+id/list_then"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />


            <TextView
                android:id="@+id/label_later"
                style="@style/MuseBoard.SectionLabel"
                android:text="@string/section_later" />

            <LinearLayout
                android:id="@+id/list_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_done"
                style="@style/MuseBoard.SectionLabel"
                android:text="@string/section_done" />

            <LinearLayout
                android:id="@+id/list_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Weekly recap (issue #8) -->
            <TextView
                android:id="@+id/label_week"
                style="@style/MuseBoard.SectionLabel" />

            <LinearLayout
                android:id="@+id/list_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_add_widget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/mb_button_tonal"
                android:stateListAnimator="@animator/mb_press"
                android:text="@string/add_widget"
                android:textAllCaps="false"
                android:textColor="@color/mb_on_surface"
                android:textSize="15sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

<!-- "✓ Done. 2 today. Undo": floats above the + for a few seconds after
     an action, like a native snackbar. -->
<LinearLayout
    android:id="@+id/undo_bar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="bottom"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="108dp"
    android:background="@drawable/mb_snackbar_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/undo_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/mb_on_surface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/undo_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/mb_ripple_rounded"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:stateListAnimator="@animator/mb_press"
        android:text="@string/undo"
        android:textColor="@color/mb_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>

<!-- Quick-add (issues #6, #13): the big + at the bottom centre -->
<ImageView
    android:id="@+id/btn_add_task"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="28dp"
    android:background="@drawable/mb_fab_bg"
    android:contentDescription="@string/add_task"
    android:elevation="6dp"
    android:scaleType="center"
    android:src="@drawable/mb_ic_add_fab"
    android:stateListAnimator="@animator/mb_press"
    android:visibility="gone" />
</FrameLayout>
