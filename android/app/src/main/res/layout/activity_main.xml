<?xml version="1.0" encoding="utf-8"?>
<!-- App screen, same design as the widget and web app
     (docs/design-system.md). Focus card and task rows are SwipeRows:
     swipe right = Done, swipe left = Later, long-press = menu. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mb_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/mb_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mb_muted"
                android:textSize="14sp" />

            <!-- Theme (issue #11): Auto → Light → Dark -->
            <ImageView
                android:id="@+id/theme_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/mb_ripple_rounded"
                android:scaleType="center" />
        </LinearLayout>

        <!-- Offline: the cached board stays, with this quiet line -->
        <TextView
            android:id="@+id/offline_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/offline_note"
            android:textColor="@color/mb_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- First run: paste the board token once -->
        <LinearLayout
            android:id="@+id/token_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/mb_card_bg"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/token_title"
                android:textColor="@color/mb_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/token_hint"
                android:textColor="@color/mb_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/token_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:autofillHints=""
                android:background="@drawable/mb_field_bg"
                android:hint="@string/token_hint_input"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/mb_on_surface"
                android:textColorHint="@color/mb_muted" />

            <Button
                android:id="@+id/token_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/mb_button_primary"
                android:stateListAnimator="@null"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/mb_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/token_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/token_invalid"
                android:textColor="@color/mb_on_surface"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Signed in -->
        <LinearLayout
            android:id="@+id/board_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <tech.mourid.museboard.SwipeRow
                android:id="@+id/focus_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <include layout="@layout/swipe_background" />

                <LinearLayout
                    android:id="@+id/focus_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mb_card_bg"
                    android:gravity="center_vertical"
                    android:longClickable="true"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/focus_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true"
                            android:textColor="@color/mb_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/focus_step"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/mb_on_surface"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/focus_task"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/mb_muted"
                            android:textSize="14sp" />

                        <!-- "Too big?" (issue #7): after two snoozes -->
                        <TextView
                            android:id="@+id/focus_too_big"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/mb_chip_tonal_inset"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/too_big"
                            android:textColor="@color/mb_on_surface"
                            android:textSize="13sp"
                            android:visibility="gone" />
                        <!-- Go-to link (issue #12) -->
                        <TextView
                            android:id="@+id/focus_open"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/mb_chip_tonal_inset"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/open_link"
                            android:textColor="@color/mb_on_surface"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <CheckBox
                            android:id="@+id/focus_check"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@null"
                            android:button="@drawable/mb_check_button"
                            android:contentDescription="@string/done_label"
                            android:gravity="center"
                            android:paddingStart="2dp"
                            android:paddingTop="2dp" />

                        <TextView
                            android:id="@+id/focus_later"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/mb_pill_tonal_inset"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/later"
                            android:textColor="@color/mb_on_surface"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </tech.mourid.museboard.SwipeRow>

            <!-- "✓ Done. 2 today. Undo" for a few seconds after an action -->
            <LinearLayout
                android:id="@+id/undo_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/mb_button_tonal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/undo_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/mb_on_surface"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/undo_button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/mb_ripple_rounded"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/undo"
                    android:textColor="@color/mb_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/gesture_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:text="@string/gesture_hint"
                android:textColor="@color/mb_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/label_then"
                style="@style/MuseBoard.SectionLabel"
                android:text="@string/section_then" />

            <LinearLayout
                android:id="@+id/list_then"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Quick-add (issue #6) -->
            <TextView
                android:id="@+id/btn_add_task"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/mb_pill_tonal"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/mb_ic_add24"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/add_task"
                android:textColor="@color/mb_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/label_later"
                style="@style/MuseBoard.SectionLabel"
                android:text="@string/section_later" />

            <LinearLayout
                android:id="@+id/list_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/label_done"
                style="@style/MuseBoard.SectionLabel"
                android:text="@string/section_done" />

            <LinearLayout
                android:id="@+id/list_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Weekly recap (issue #8) -->
            <TextView
                android:id="@+id/label_week"
                style="@style/MuseBoard.SectionLabel" />

            <LinearLayout
                android:id="@+id/list_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_add_widget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/mb_button_tonal"
                android:stateListAnimator="@null"
                android:text="@string/add_widget"
                android:textAllCaps="false"
                android:textColor="@color/mb_on_surface"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_history"
                    style="@style/MuseBoard.FooterLink"
                    android:text="@string/history" />

                <TextView
                    style="@style/MuseBoard.FooterLink"
                    android:importantForAccessibility="no"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="·" />

                <TextView
                    android:id="@+id/btn_refresh"
                    style="@style/MuseBoard.FooterLink"
                    android:text="@string/refresh" />

                <TextView
                    style="@style/MuseBoard.FooterLink"
                    android:importantForAccessibility="no"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="·" />

                <TextView
                    android:id="@+id/btn_change_token"
                    style="@style/MuseBoard.FooterLink"
                    android:text="@string/change_token" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
