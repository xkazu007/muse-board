<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tech.mourid.museboard">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Plan reminders (Android 13+ asks the user once, from the app). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MuseBoard">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- History: all completed tasks, by day -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Task detail page (tap a task in the app) -->
        <activity
            android:name=".TaskActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- App icon shortcuts (Done / Later): invisible, forwards and closes -->
        <activity
            android:name=".ShortcutActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- True home-screen widget -->
        <receiver
            android:name=".MuseBoardWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/muse_board_widget_info" />
        </receiver>

        <!-- Widget button taps (Done / Not now / refresh) -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="tech.mourid.museboard.ACTION_DONE" />
                <action android:name="tech.mourid.museboard.ACTION_SNOOZE" />
                <action android:name="tech.mourid.museboard.ACTION_REFRESH" />
                <action android:name="tech.mourid.museboard.ACTION_LATER_SHOW" />
                <action android:name="tech.mourid.museboard.ACTION_LATER_CANCEL" />
                <action android:name="tech.mourid.museboard.ACTION_UNDO" />
            </intent-filter>
        </receiver>

        <!-- Plan reminder: one notification at a task's plan time -->
        <receiver
            android:name=".PlanReminderReceiver"
            android:exported="false" />

        <!-- Board refresh: 30-minute alarm tick, explicit refresh, boot -->
        <receiver
            android:name=".WidgetRefreshReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
